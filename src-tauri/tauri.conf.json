{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "List2Cart",
  "version": "0.0.1",
  "identifier": "hr.list2cart.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "List2Cart — Pametna kupnja. Točan račun.",
        "width": 1060,
        "height": 740,
        "minWidth": 380,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
